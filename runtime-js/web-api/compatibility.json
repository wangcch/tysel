{
  "schemaVersion": 1,
  "profile": "tysel-server-web-subset",
  "stability": "stable",
  "apis": [
    {
      "name": "URL and URLSearchParams",
      "status": "partial",
      "supported": [
        "absolute and relative authority-based URLs",
        "dot-segment path normalization",
        "live search and searchParams mutation",
        "iterable and record URLSearchParams initialization"
      ],
      "unsupported": [
        "full WHATWG parsing",
        "IDNA",
        "username/password properties",
        "file and blob URLs"
      ]
    },
    {
      "name": "Headers",
      "status": "partial",
      "supported": [
        "record, Headers, and pair initialization",
        "get/set/append/delete/has",
        "live sorted iteration across header mutations",
        "iterable pair initialization",
        "HTTP token and CR/LF validation",
        "independent Set-Cookie values and getSetCookie snapshots"
      ],
      "unsupported": [
        "browser header guards"
      ]
    },
    {
      "name": "Request and Response",
      "status": "partial",
      "supported": [
        "string, ArrayBuffer, and ArrayBufferView request/response bodies with byte-preserving consumption",
        "single-use json/text/arrayBuffer consumption",
        "bodyUsed",
        "buffered request and response clone",
        "streamed host request and response bodies",
        "UTF-8 decoding after byte collection, including split code points and BOM handling",
        "Tysel response chunk arrays with snapshotted string/ArrayBuffer/ArrayBufferView elements",
        "lazy ReadableStream body access with locking and disturbance",
        "Response with a ReadableStream of Uint8Array chunks, native backpressure and cancellation"
      ],
      "unsupported": [
        "formData/blob helpers",
        "streamed request and response clone",
        "browser cache/credentials/mode semantics"
      ]
    },
    {
      "name": "TextEncoder and TextDecoder",
      "status": "partial",
      "supported": [
        "UTF-8 encode and decode",
        "stateful UTF-8 decode with stream option and final flush",
        "TextDecoderStream over TransformStream"
      ],
      "unsupported": [
        "legacy encodings",
        "TextEncoder.encodeInto"
      ]
    },
    {
      "name": "Timers",
      "status": "supported",
      "supported": [
        "setTimeout",
        "clearTimeout",
        "setInterval",
        "clearInterval",
        "isolate reset cleanup"
      ],
      "unsupported": []
    },
    {
      "name": "Event and EventTarget",
      "status": "partial",
      "supported": [
        "function and object listeners",
        "listener deduplication and removal",
        "once and AbortSignal options",
        "preventDefault and immediate propagation stop"
      ],
      "unsupported": [
        "DOM event trees",
        "capture and bubble phases",
        "browser exception reporting"
      ]
    },
    {
      "name": "AbortController and AbortSignal",
      "status": "partial",
      "supported": [
        "abort reason",
        "throwIfAborted",
        "AbortSignal.abort",
        "AbortSignal.timeout",
        "fetch and response-body cancellation",
        "AbortSignal.any with first reason and dependency cleanup"
      ],
      "unsupported": [
        "browser task scheduling guarantees"
      ]
    },
    {
      "name": "Crypto",
      "status": "partial",
      "supported": [
        "getRandomValues",
        "SHA-256/384/512 digest",
        "raw HMAC import/sign/verify",
        "randomUUID (cryptographic UUID v4)"
      ],
      "unsupported": [
        "key export",
        "encryption",
        "asymmetric algorithms"
      ]
    },
    {
      "name": "fetch",
      "status": "partial",
      "supported": [
        "HTTP methods allowed by host policy",
        "headers and byte-preserving buffered request bodies",
        "redirect policy",
        "streamed response consumption",
        "AbortSignal cancellation",
        "response.body reader, async iteration and cancellation",
        "multiple Set-Cookie headers preserved"
      ],
      "unsupported": [
        "streaming request bodies",
        "multipart/form data",
        "browser cache/credentials/mode semantics"
      ]
    },
    {
      "name": "WebSocket",
      "status": "partial",
      "supported": [
        "outbound and accepted sockets",
        "text messages",
        "open/message/error/close listeners",
        "once and listener removal",
        "native cleanup on isolate reuse"
      ],
      "unsupported": [
        "subprotocol negotiation",
        "extensions",
        "Blob messages",
        "bufferedAmount"
      ]
    },
    {
      "name": "Streams",
      "status": "partial",
      "supported": [
        "ReadableStream default readers and async iteration",
        "WritableStream writer locks, ready and serial writes",
        "TransformStream, pipeThrough, pipeTo with backpressure and AbortSignal",
        "tee, cancellation and error propagation",
        "ByteLengthQueuingStrategy and CountQueuingStrategy"
      ],
      "unsupported": [
        "HTTP streaming uploads",
        "HTTP body BYOB readers",
        "transfer of host-owned external buffers",
        "streamed Body.clone"
      ]
    },
    {
      "name": "Microtasks and base64",
      "status": "supported",
      "supported": [
        "queueMicrotask with callback validation, native job ordering and request-generation cleanup",
        "atob and btoa with Latin-1 binary strings and InvalidCharacterError"
      ],
      "unsupported": []
    }
  ]
}
