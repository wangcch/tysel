{
  "name": "tysel-website",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "sync:brand": "node scripts/sync-brand.mjs",
    "sync:benchmarks": "bash ../.github/scripts/fetch-benchmark-evidence.sh",
    "import:docs": "node scripts/import-docs.mjs",
    "check:docs-contracts": "node scripts/check-docs-contracts.mjs",
    "test:benchmarks": "node --experimental-strip-types --test test/build-admission-board.test.mjs",
    "predev": "node scripts/sync-brand.mjs && node scripts/import-docs.mjs",
    "prebuild": "node scripts/sync-brand.mjs && node scripts/import-docs.mjs",
    "dev": "next dev --port 4000",
    "build": "next build --webpack",
    "start": "next start --port 4000",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.15.1",
    "fumadocs-mdx": "15.3.1",
    "fumadocs-ui": "16.15.1",
    "lucide-react": "^0.562.0",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
