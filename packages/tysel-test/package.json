{
  "name": "@tysel/test",
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Test helpers for Tysel fetch handlers and durable tasks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangcch/tysel.git",
    "directory": "packages/tysel-test"
  },
  "homepage": "https://tysel.dev/docs/",
  "bugs": {
    "url": "https://github.com/wangcch/tysel/issues"
  },
  "keywords": ["tysel", "typescript", "testing", "quickjs"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@tysel/types": "workspace:*"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
