{
  "name": "@tysel/types",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "Shared TypeScript types for Tysel applications and capabilities.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangcch/tysel.git",
    "directory": "packages/tysel-types"
  },
  "homepage": "https://tysel.dev/docs/",
  "bugs": {
    "url": "https://github.com/wangcch/tysel/issues"
  },
  "keywords": ["tysel", "typescript", "types", "runtime"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist", "LICENSE", "README.md"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
